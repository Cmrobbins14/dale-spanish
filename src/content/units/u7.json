      "title": "Mi rutina",
      "subtitle": "Morning and night",
      "icon": "🌅",
      "canDo": "I can say when I get up and go to bed",
      "scenario": "Comparing schedules with your cousin",
      "intro": [
        { "en": "Early bird or night owl? Let's talk about your day." },
        { "en": "I get up at seven:", "es": "Me levanto a las siete." },
        { "en": "Your turn!" }
      ],
      "phrases": [
        { "id": "me-levanto", "es": "Me levanto a las siete.", "en": "I get up at seven.", "pic": "⏰", "help": "Me levanto = I get up. A las + time = at that time." },
        { "id": "me-acuesto", "es": "Me acuesto a las nueve.", "en": "I go to bed at nine.", "pic": "🛏️", "help": "Me acuesto = I go to bed." },
        { "id": "a-que-hora", "es": "¿A qué hora te levantas?", "en": "What time do you get up?", "pic": "❓", "help": "A qué hora = at what time." }
      ],
      "frame": {
        "id": "me-levanto-x",
        "es": "Me levanto a las {x}.",
        "en": "I get up at {x}.",
        "help": "Swap in your wake-up time.",
        "fillers": [
          { "es": "seis", "en": "six", "pic": "🕕" },
          { "es": "seis y media", "en": "six thirty", "pic": "🕡" },
          { "es": "siete y cuarto", "en": "seven fifteen", "pic": "🕖" },
          { "es": "ocho", "en": "eight", "pic": "🕗" }
        ]
      },
      "qa": [
        { "q": "¿A qué hora te levantas?", "qEn": "What time do you get up?", "open": true, "accept": ["me levanto a las {number}", "a las {number}", "me levanto a la una", "{number}"], "model": "Me levanto a las siete.", "hint": "Me levanto a las ___.", "concept": "me-levanto" },
        { "q": "¿A qué hora te acuestas?", "qEn": "What time do you go to bed?", "open": true, "accept": ["me acuesto a las {number}", "a las {number}", "{number}"], "model": "Me acuesto a las nueve.", "hint": "Me acuesto a las ___.", "concept": "me-acuesto" },
        { "q": "Pregúntale a tu primo a qué hora se levanta.", "qEn": "Ask your cousin what time he gets up.", "say": "¿A qué hora te levantas?", "concept": "a-que-hora" }
      ]
    },
