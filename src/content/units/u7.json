      "phrases": [
        { "id": "que-dia-es-hoy", "es": "¿Qué día es hoy?", "en": "What day is it today?", "pic": "📅", "help": "Día = day. Hoy = today (the H is silent: \"OY\")." },
        { "id": "hoy-es-viernes", "es": "Hoy es viernes.", "en": "Today is Friday.", "pic": "🎉", "help": "Days aren't capitalized in Spanish!" },
        { "id": "el-sabado-juego", "es": "El sábado juego fútbol.", "en": "On Saturday I play soccer.", "pic": "⚽", "help": "El sábado = on Saturday. No word for \"on\" needed.", "tip": "Use el before a day to mean \"on that day\": el lunes = on Monday. Los lunes = on Mondays (every week)." }
      ],
      "frame": {
        "id": "hoy-es-x",
        "es": "Hoy es {x}.",
        "en": "Today is {x}.",
        "help": "Hoy es + day.",
        "fillers": [
          { "es": "lunes", "en": "Monday", "pic": "1️⃣" },
          { "es": "miércoles", "en": "Wednesday", "pic": "3️⃣" },
          { "es": "sábado", "en": "Saturday", "pic": "6️⃣" },
          { "es": "domingo", "en": "Sunday", "pic": "7️⃣" }
        ]
      },
      "slots": { "day": ["lunes", "martes", "miercoles", "jueves", "viernes", "sabado", "domingo"] },
      "qa": [
        { "q": "¿Qué día es hoy?", "qEn": "What day is it today?", "open": true, "accept": ["hoy es {day}", "es {day}", "{day}"], "model": "Hoy es viernes.", "hint": "Hoy es ___.", "concept": "hoy-es-x" },
        { "q": "¿Qué día juegas fútbol?", "qEn": "What day do you play soccer?", "open": true, "accept": ["el {day} juego futbol", "los {day} juego futbol", "el {day}", "los {day}", "{day}"], "model": "El sábado juego fútbol.", "hint": "El ___ juego fútbol.", "concept": "el-sabado-juego" },
        { "q": "No sabes qué día es. ¿Qué preguntas?", "qEn": "You don't know what day it is. What do you ask?", "say": "¿Qué día es hoy?", "concept": "que-dia-es-hoy" }
