    {
      "id": "u7-l1",
      "type": "lesson",
      "title": "¿Qué hora es?",
      "subtitle": "Telling time",
      "icon": "🕒",
      "canDo": "I can tell the time",
      "scenario": "Checking the clock so you're not late for practice",
      "intro": [
        { "en": "Don't be late for practice! Let's learn to tell time." },
        { "en": "What time is it?", "es": "¿Qué hora es?" },
        { "en": "Ask it!" }
      ],
      "phrases": [
        { "id": "que-hora-es", "es": "¿Qué hora es?", "en": "What time is it?", "pic": "⏰", "help": "Hora = hour or time. The H is silent: \"OH-rah\"." },
        { "id": "es-la-una", "es": "Es la una.", "en": "It's one o'clock.", "pic": "🕐", "help": "One o'clock is special: es la una.", "tip": "Use es la for one o'clock and son las for every other hour: son las dos, son las tres." },
        { "id": "son-las-tres", "es": "Son las tres.", "en": "It's three o'clock.", "pic": "🕒", "help": "Son las + number for 2 o'clock and up." }
      ],
      "frame": {
        "id": "son-las-x",
        "es": "Son las {x}.",
        "en": "It's {x}.",
        "help": "Son las + hour. Add y media for :30 and y cuarto for :15.",
        "fillers": [
          { "es": "dos", "en": "two o'clock", "pic": "🕑" },
          { "es": "cinco y media", "en": "five thirty", "pic": "🕠" },
          { "es": "siete", "en": "seven o'clock", "pic": "🕖" },
          { "es": "ocho y cuarto", "en": "a quarter past eight", "pic": "🕗" }
        ]
      },
      "qa": [
        { "q": "¿Qué hora es?", "qEn": "What time is it?", "pic": "🕒", "say": "Son las tres.", "concept": "son-las-tres" },
        { "q": "¿Qué hora es?", "qEn": "What time is it?", "pic": "🕐", "say": "Es la una.", "concept": "es-la-una" },
        { "q": "¿A qué hora es tu entrenamiento?", "qEn": "What time is your practice?", "open": true, "accept": ["es a las {number}", "a las {number}", "a la una", "es a la una", "{number}", "no tengo entrenamiento"], "model": "Es a las cinco.", "hint": "Es a las ___.", "concept": "son-las-x" }
      ]
    },
    {
      "id": "u7-l2",
